# Copy to .env.local and fill in values (never commit .env.local)

# ============================================================
# Database (local PostgreSQL in Docker)
# For pnpm dev outside Docker use localhost instead of postgres
# ============================================================
DATABASE_URL=postgresql://marinero:marinero_local_password@localhost:5432/marinero

# ============================================================
# Auth (NextAuth.js)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --- Social sign-in ---
# Each provider is optional: it only appears on the login/sign-up pages when both
# of its vars are filled in. Redirect/callback URI pattern (localhost):
#   http://localhost:3000/api/auth/callback/<provider>

# Google — redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple — redirect URI: https://<your-domain>/api/auth/callback/apple
# Apple does NOT allow http/localhost redirects — testing requires an HTTPS URL.
# APPLE_CLIENT_ID = your Services ID (e.g. art.marinero.web), NOT the App ID.
# APPLE_CLIENT_SECRET is a JWT that expires ≤ 6 months. Regenerate it with:
#   pnpm auth:apple-secret   (needs APPLE_TEAM_ID, APPLE_KEY_ID + the AuthKey_*.p8)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# VK (ВКонтакте) — redirect URI: http://localhost:3000/api/auth/callback/vk
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Yandex — redirect URI: http://localhost:3000/api/auth/callback/yandex
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Spotify — redirect URI: http://localhost:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Facebook — redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Telegram Login Widget (via @BotFather). Set the bot domain to your site.
# TELEGRAM_BOT_TOKEN enables the server-side provider; TELEGRAM_BOT_USERNAME
# (without the leading @) renders the widget button. Widget needs a public domain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ============================================================
# File storage (local MinIO — emulates AWS S3)
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_PUBLIC=marinero-public
S3_BUCKET_PRIVATE=marinero-private
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/marinero-public

# ============================================================
# Email (Resend)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@marinero.art

# ============================================================
# Public site URL
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# Optional: migrate users from legacy Supabase DB
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
