# Copy to .env.local and fill in values (never commit .env.local)

# ============================================================
# Database (local PostgreSQL in Docker)
# For pnpm dev outside Docker use localhost instead of postgres
# ============================================================
DATABASE_URL=postgresql://marinero:marinero_local_password@localhost:5432/marinero

# ============================================================
# Auth (NextAuth.js)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# File storage (local MinIO — emulates AWS S3)
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_PUBLIC=marinero-public
S3_BUCKET_PRIVATE=marinero-private
NEXT_PUBLIC_STORAGE_URL=http://localhost:9000/marinero-public

# ============================================================
# Email (Resend)
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@marinero.art

# ============================================================
# Public site URL
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# Optional: migrate users from legacy Supabase DB
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
