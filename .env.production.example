# Copy to .env.production on the server (never commit secrets)

POSTGRES_PASSWORD=change-me-strong-password

DATABASE_URL=postgresql://marinero:change-me-strong-password@postgres:5432/marinero

NEXTAUTH_URL=https://marinero.art
NEXTAUTH_SECRET=
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 (eu-north-1) — do NOT set S3_ENDPOINT on prod
S3_REGION=eu-north-1
S3_BUCKET_PUBLIC=marinero-public
S3_BUCKET_PRIVATE=marinero-private
NEXT_PUBLIC_STORAGE_URL=https://marinero-public.s3.eu-north-1.amazonaws.com

# Optional if EC2 IAM role is attached (marinero-ec2-s3):
# Если аудио на prod не играет, а фото открываются — Docker не видит IAM role.
# Временно задайте ключи IAM-пользователя marinero-deploy:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Миграция пользователей из старой базы Supabase (временно, до полного переезда).
# Запуск: Admin → Обзор → Технические действия, либо `pnpm users:migrate`.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@marinero.art

NEXT_PUBLIC_SITE_URL=https://marinero.art
NODE_ENV=production
