# Inputs for `pnpm auth:apple-secret` (generates APPLE_CLIENT_SECRET).
# Copy to .env.apple (gitignored) and fill in. Re-run every ≤ 6 months.

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
# Path to the AuthKey_XXXX.p8 downloaded from Apple (keep it out of git).
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
